<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>
    <groupId>dev.codecomp</groupId>
    <artifactId>codecomp-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <!--
      Microservices, split by business domain. Each service owns its tables and talks to the others only over HTTP
      and messages (SQS queues, an SNS topic). A service never depends on another service's module.

      Shared libraries (no business logic):
        contracts         what services exchange: run events, JobView, RunResult, the sandbox language list
        messaging         SQS/SNS client: send, publish, listen to a queue
        platform          web-service plumbing: JWT sign-in check, CSRF, @CurrentUser, rate limiting, errors

      Services (one runnable jar and one image each):
        identity-service  Google sign-in, users, issues the JWT every other service checks
        exercise-service  snippet exercises and attempts
        repo-service      repo exercises: reviews, Ask AI, inline edits, recording and scoring test runs
        run-service       the run queue: accepts runs, result cache, live updates (SSE)
        sandbox-worker    runs code in sandbox containers; no database, the only one with Docker access

      Tests only, never deployed:
        content-tests     runs every exercise in a real sandbox to check the content is honest
    -->
    <modules>
        <module>contracts</module>
        <module>messaging</module>
        <module>platform</module>
        <module>identity-service</module>
        <module>exercise-service</module>
        <module>repo-service</module>
        <module>run-service</module>
        <module>sandbox-worker</module>
        <module>content-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <aws.sdk.version>2.55.16</aws.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-contracts</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-messaging</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-platform</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-exercise-service</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-repo-service</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-sandbox-worker</artifactId><version>${project.version}</version></dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- the runnable jar is *-exec.jar; the plain jar stays usable as a dependency (content-tests) -->
                        <classifier>exec</classifier>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
