<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>
    <groupId>dev.codecomp</groupId>
    <artifactId>codecomp-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <!--
      One jar per process, so each contains only the code it runs:
        core        entities, queue and cache tables, scoring, sandbox config, migrations (a library, not an app)
        api         the web API: sign-in, exercises, grading, queueing runs, live updates, Claude
        worker      runs queued code in the sandbox; the only one with Docker access
        seed        loads the exercises into the database, then exits
        all-in-one  all three in one process: the integration tests and local development
      Every app starts dev.codecomp.CodecompApplication (in core); it picks up whatever is on its classpath.
    -->
    <modules>
        <module>core</module>
        <module>api</module>
        <module>worker</module>
        <module>seed</module>
        <module>all-in-one</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- only the all-in-one module may be started with spring-boot:run -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-core</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-api</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-worker</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-seed</artifactId><version>${project.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <mainClass>dev.codecomp.CodecompApplication</mainClass>
                        <!-- the runnable jar is *-exec.jar; the plain jar stays usable as a dependency (all-in-one, tests) -->
                        <classifier>exec</classifier>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
