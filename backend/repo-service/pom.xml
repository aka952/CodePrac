<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.codecomp</groupId>
        <artifactId>codecomp-parent</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>codecomp-repo-service</artifactId>
    <description>
        Repo exercises: reviews graded by Claude, Ask AI, inline AI edits, hidden-test runs (submitted to run-service,
        recorded and scored from its events). Owns: repo_exercises, repo_submissions, pending_runs. Seeds its own content.
    </description>

    <dependencies>
        <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-platform</artifactId></dependency>
        <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-contracts</artifactId></dependency>
        <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-messaging</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
        <dependency><groupId>com.anthropic</groupId><artifactId>anthropic-java</artifactId><version>3.8.0</version></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    </dependencies>

    <build>
        <finalName>repo-service</finalName>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
