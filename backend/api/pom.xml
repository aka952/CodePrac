<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.codecomp</groupId>
        <artifactId>codecomp-parent</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>codecomp-api</artifactId>
    <description>The web API. Queues code runs but never runs code, so it needs no Docker access</description>

    <dependencies>
        <dependency><groupId>dev.codecomp</groupId><artifactId>codecomp-core</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-oauth2-client</artifactId></dependency>
        <dependency><groupId>com.anthropic</groupId><artifactId>anthropic-java</artifactId><version>3.8.0</version></dependency>
    </dependencies>

    <build>
        <finalName>codecomp-api</finalName>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
