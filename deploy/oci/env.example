# Copy to the repository root as .env and fill in:   cp deploy/oci/env.example .env && chmod 600 .env

# Lets you run plain `docker compose ...` with the production overrides applied.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Required. Generate one with:  openssl rand -hex 24
# Postgres only reads this the first time it starts; changing it later needs ALTER USER in the database too.
POSTGRES_PASSWORD=

# ":80" = plain HTTP on the server's IP. Set a domain that points at this server to get automatic HTTPS, e.g. code.example.com
SITE_ADDRESS=:80

# Required: Google sign-in (see docs/DEPLOY_OCI.md, "Google sign-in"). Google only allows HTTPS redirect
# addresses for a public server, so SITE_ADDRESS must be a domain for sign-in to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Enables review grading and Ask AI.
ANTHROPIC_API_KEY=

# Sandbox runtime. Defaults to runsc (gVisor) when this line is absent. Uncomment and leave empty to use Docker's default runc.
#SANDBOX_RUNTIME=
